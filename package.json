{
  "name": "dsh-hitchfin",
  "version": "0.5.2",
  "description": "Bring WorkBuddy, Qoder and Trae subscription models into DeepSeek Harness with multi-account failover, per-account proxies and model controls. · 将 WorkBuddy、Qoder、Trae 的订阅模型接入 DSH。",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "LuckyOneTwoThree (https://github.com/LuckyOneTwoThree)",
  "homepage": "https://github.com/LuckyOneTwoThree/dsh-hitchfin#readme",
  "bugs": {
    "url": "https://github.com/LuckyOneTwoThree/dsh-hitchfin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckyOneTwoThree/dsh-hitchfin.git"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "llm",
    "model-provider",
    "subscription",
    "workbuddy",
    "qoder",
    "trae",
    "multi-account",
    "failover",
    "proxy"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "assets",
    "lib",
    "worker",
    "client",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20.18.1",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node scripts/contract-probe.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-authorization": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@magpie-community/opencode-qoder-auth": "0.2.61",
    "@magpie-community/opencode-trae-auth": "0.2.30",
    "@magpie-community/opencode-workbuddy-auth": "0.2.24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "undici": "^7.30.2"
  }
}
